<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Presiden RI Simulator</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-white min-h-screen p-6">
  <div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center border-b border-slate-800 pb-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold">🇮🇩 Presiden RI Simulator</h1>
        <p class="text-slate-400 text-sm">Nyambung ke Bot WA Termux</p>
      </div>
      <div id="hari" class="text-xl font-bold text-amber-400">Hari ke-1</div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
      <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400">APBN</div>
        <div id="apbn" class="text-xl font-bold text-emerald-400 mt-1">Rp 1000 T</div>
      </div>
      <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400">Elektabilitas</div>
        <div id="elektabilitas" class="text-xl font-bold text-sky-400 mt-1">50%</div>
      </div>
      <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400">Rakyat Puas</div>
        <div id="rakyat" class="text-xl font-bold text-amber-400 mt-1">60%</div>
      </div>
      <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400">Ekonomi</div>
        <div id="ekonomi" class="text-xl font-bold text-purple-400 mt-1">55%</div>
      </div>
    </div>

    <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 mb-6">
      <div class="text-sm font-bold text-slate-300 mb-2">📰 Berita Terakhir</div>
      <div id="berita" class="text-slate-400 text-sm">Menunggu data...</div>
    </div>

    <div class="flex flex-wrap gap-2">
      <button onclick="aksi('Bagi BLT', -150, 12, 15, -5)" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded-lg text-sm font-semibold">💸 Bagi BLT</button>
      <button onclick="aksi('Bangun Tol & IKN', -300, 5, 5, 20)" class="bg-sky-600 hover:bg-sky-500 px-4 py-2 rounded-lg text-sm font-semibold">🏗️ Bangun Infrastruktur</button>
      <button onclick="aksi('Naikkan Pajak', 250, -15, -18, 5)" class="bg-amber-600 hover:bg-amber-500 px-4 py-2 rounded-lg text-sm font-semibold">🧾 Naikkan Pajak</button>
      <button onclick="resetGame()" class="bg-red-700 hover:bg-red-600 px-4 py-2 rounded-lg text-sm font-semibold">🔄 Reset</button>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getDatabase, ref, onValue, set, get } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

    const app = initializeApp({
      databaseURL: "https://presiden-ri-simulator-default-rtdb.asia-southeast1.firebasedatabase.app"
    });
    const db = getDatabase(app);
    const negaraRef = ref(db, "presiden_ri");

    onValue(negaraRef, (snap) => {
      const d = snap.val();
      if (!d) return window.resetGame();
      document.getElementById("hari").innerText = `Hari ke-${d.hari}`;
      document.getElementById("apbn").innerText = `Rp ${d.apbn} T`;
      document.getElementById("elektabilitas").innerText = `${d.elektabilitas}%`;
      document.getElementById("rakyat").innerText = `${d.rakyat}%`;
      document.getElementById("ekonomi").innerText = `${d.ekonomi}%`;
      document.getElementById("berita").innerText = d.berita;
    });

    const clamp = (n) => Math.max(0, Math.min(100, n));

    window.aksi = async (nama, dApbn, dElek, dRakyat, dEko) => {
      const cur = (await get(negaraRef)).val();
      await set(negaraRef, {
        hari: cur.hari + 1,
        apbn: cur.apbn + dApbn,
        elektabilitas: clamp(cur.elektabilitas + dElek),
        rakyat: clamp(cur.rakyat + dRakyat),
        ekonomi: clamp(cur.ekonomi + dEko),
        berita: `[WEB] Keputusan: ${nama}`
      });
    };

    window.resetGame = async () => {
      await set(negaraRef, {
        hari: 1, apbn: 1000, elektabilitas: 50, rakyat: 60, ekonomi: 55,
        berita: "Game dimulai! Ketik .menu di WA."
      });
    };
  </script>
</body>
</html>
